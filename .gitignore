# Course material files (PDFs/slides) — kept local only.
# Copyrighted USN course content shouldn't be redistributed via a public
# GitHub Pages deploy; the site's resource links assume these exist locally.
assets/resources/*/*
!assets/resources/*/.gitkeep

# Exception: TSD3060 example code and solutions from the course system are
# published on purpose (the user considers them open source). Non-code files
# such as the PDF stay local.
!assets/resources/tsd3060/eksempler/
!assets/resources/tsd3060/losninger/
assets/resources/tsd3060/**/*.pdf

# Exception: past Fysikk 2 exams (PB1120/PB2050) and their solutions are
# published on purpose so the links on the exam set page work on GitHub Pages
# (the user's decision, 2026-10-07). Lectures, labs and the compendium stay local.
!assets/resources/fysikk2/Eksamensoppgaver/

# OS
.DS_Store
Thumbs.db
